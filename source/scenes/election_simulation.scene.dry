Q.lunarian_ndp = 26;
Q.lunarian_tpk = 10;
Q.lunarian_unity = 15;
Q.lunarian_afk = 7;
Q.lunarian_pse = 14;
Q.lunarian_fnj = 18;
Q.lunarian_other = 5;
!}
go-to: election_algorithm
set-jump: post_election

