title: Election Simulation
set-jump: post_election


- @1928: 1928 historical scenario
- @1930: 1930 historical scenario
- @1932: 1932 (July) historical scenario

@1928
on-arrival: {!
Q.workers = 46; // industry and trade
Q.old_middle = 13; // "old mittelstand"
// 16.4 trade & commerce, 6.6 public and private services, 4.4 domestic help
Q.new_middle = 14; // "new mittelstand"
Q.rural = 25; // agriculture and forestry employment... but many of those are proletarians so...
// source: https://surface.syr.edu/cgi/viewcontent.cgi?filename=3&article=1016&context=books&type=additional page 43, table 3.3
Q.unemployed = 8.6;
Q.catholics = 30;

Q.classes = ['workers', 'middle_class', 'urban_cosmopolitan', 'rural', 'unemployed', 'retired', 'martian', 'lunarian'];
Q.parties = ['ndp', 'tpk', 'unity', 'afk', 'pse', 'fnj', 'other'];

// Support for party by social group
// they don't have to sum to 100 since the electoral calculations will be normalized.
Q.workers_ndp = 18;
Q.workers_tpk = 22;
Q.workers_unity = 26;
Q.workers_afk = 14;
Q.workers_pse = 8;
Q.workers_fnj = 2;
Q.workers_other = 0;

Q.middle_class_ndp = 32;
Q.middle_class_tpk = 24;
Q.middle_class_unity = 14;
Q.middle_class_afk = 8;
Q.middle_class_pse = 3;
Q.middle_class_fnj = 7;
Q.middle_class_other = 2;

Q.urban_cosmopolitan_ndp = 30;
Q.urban_cosmopolitan_tpk = 6;
Q.urban_cosmopolitan_unity = 22;
Q.urban_cosmopolitan_afk = 6;
Q.urban_cosmopolitan_pse = 10;
Q.urban_cosmopolitan_fnj = 17;
Q.urban_cosmopolitan_other = 2;

Q.rural_ndp = 12;
Q.rural_tpk = 40;
Q.rural_unity = 8;
Q.rural_afk = 33;
Q.rural_pse = 4;
Q.rural_fnj = 22;
Q.rural_other = 2;

Q.unemployed_ndp = 15;
Q.unemployed_tpk = 20;
Q.unemployed_unity = 20;
Q.unemployed_afk = 18;
Q.unemployed_pse = 35;
Q.unemployed_fnj = 2;
Q.unemployed_other = 2;

Q.retired_ndp = 36;
Q.retired_tpk = 32;
Q.retired_unity = 16;
Q.retired_afk = 8;
Q.retired_pse = 4;
Q.retired_fnj = 2;
